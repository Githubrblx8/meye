# M'Eye Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Application name
APP_NAME=M'Eye

# Environment (development, staging, production)
ENVIRONMENT=development

# Secret key for JWT tokens and session encryption
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production

# JWT token expiration in minutes
JWT_EXPIRATION_MINUTES=1440

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================

POSTGRES_USER=meye
POSTGRES_PASSWORD=change-me-secure-password
POSTGRES_DB=meye
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://meye:change-me-secure-password@db:5432/meye

# ===========================================
# REDIS
# ===========================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ===========================================
# API SETTINGS
# ===========================================

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# WEB UI
# ===========================================

WEB_HOST=0.0.0.0
WEB_PORT=3000

# ===========================================
# SMTP GATEWAY
# ===========================================

SMTP_HOST=0.0.0.0
SMTP_PORT=2525
SMTP_TLS_PORT=2526

# ===========================================
# SECURITY
# ===========================================

# Password hashing rounds
BCRYPT_ROUNDS=12

# Session timeout in hours
SESSION_TIMEOUT_HOURS=24

# Max login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# ===========================================
# LOGGING
# ===========================================

LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable/disable features for MVP
ENABLE_THREAT_INTEL=false
ENABLE_OPENSEARCH=false
ENABLE_ADVANCED_ANALYTICS=false

# ===========================================
# ADMIN ACCOUNT (Initial setup)
# ===========================================

ADMIN_EMAIL=admin@m-eye.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# ===========================================
# EMAIL NOTIFICATIONS (Optional)
# ===========================================

SMTP_NOTIFICATION_HOST=
SMTP_NOTIFICATION_PORT=587
SMTP_NOTIFICATION_USER=
SMTP_NOTIFICATION_PASSWORD=
NOTIFICATION_FROM=noreply@m-eye.local

# ===========================================
# THREAT INTELLIGENCE PROVIDERS (Optional)
# ===========================================

# Add your API keys here when enabling threat intel
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
THREATFOX_API_KEY=
