# M'Eye Configuration
# Copy this file to .env and customize for your environment

# PostgreSQL Configuration
POSTGRES_USER=m_eye
POSTGRES_PASSWORD=m_eye_secure_password_change_me
POSTGRES_DB=m_eye

# Database URL (used by backend)
DATABASE_URL=postgres://m_eye:m_eye_secure_password_change_me@postgres:5432/m_eye

# Redis Configuration
REDIS_URL=redis://redis:6379

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -base64 32
JWT_SECRET=change_this_secret_key_in_production_minimum_32_chars

# JWT Configuration
JWT_ISSUER=m-eye-api
JWT_LIFETIME_SECS=3600

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# SMTP Gateway Configuration
SMTP_PORT=2525

# Logging
RUST_LOG=info
