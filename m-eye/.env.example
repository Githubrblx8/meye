# Database Configuration
POSTGRES_USER=meye_user
POSTGRES_PASSWORD=ChangeMe_StrongPass!
POSTGRES_DB=meye_db
DATABASE_URL=postgres://meye_user:ChangeMe_StrongPass!@localhost:5432/meye_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security - CHANGE THESE IN PRODUCTION!
JWT_SECRET=ChangeThisToARandomSecretKeyAtLeast32CharsLong!
JWT_ISSUER=m-eye-local
JWT_EXPIRY_HOURS=24

# Application Configuration
RUST_LOG=info,meye=debug
APP_PORT=3000
SMTP_PORT=2525

# Risk Engine Thresholds
RISK_THRESHOLD_ALLOW=30
RISK_THRESHOLD_WATCH=60
RISK_THRESHOLD_BLOCK=85

# Admin Account (First Run)
ADMIN_EMAIL=admin@m-eye.local
ADMIN_PASSWORD=Admin123!
